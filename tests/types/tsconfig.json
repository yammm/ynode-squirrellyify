{
    "compilerOptions": {
        "exactOptionalPropertyTypes": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "resolveJsonModule": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"],
        "verbatimModuleSyntax": true
    },
    "include": ["*.ts", "generated/**/*.d.ts"]
}
