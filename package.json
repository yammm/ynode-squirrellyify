{
    "name": "@ynode/squirrellyify",
    "version": "1.11.0+336722",
    "description": "Fastify 5 plugin for rendering Squirrelly templates with layout support, partials, and scoped configuration.",
    "main": "src/plugin.js",
    "types": "index.d.ts",
    "bin": {
        "squirrellyify-client": "src/client-module-cli.js"
    },
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./src/plugin.js"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "license": "MIT",
    "author": "Michael Welter <me@mikinho.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yammm/ynode-squirrellyify.git"
    },
    "bugs": {
        "url": "https://github.com/yammm/ynode-squirrellyify/issues"
    },
    "homepage": "https://github.com/yammm/ynode-squirrellyify#readme",
    "keywords": [
        "fastify",
        "fastify-plugin",
        "template",
        "view",
        "squirrelly",
        "plugin",
        "engine",
        "render",
        "html",
        "layout",
        "partials"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@mikinho/autover": "^3.0.0",
        "auto-changelog": "^2.6.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "fastify": "^5.10.0",
        "globals": "^17.7.0",
        "jsdoc": "^4.0.5",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3"
    },
    "scripts": {
        "changelog": "auto-changelog -p",
        "docs": "node scripts/gen-docs.mjs",
        "docs:check": "node scripts/gen-docs.mjs --check",
        "docs:clean": "rimraf docs || rmdir /s /q docs 2> NUL || true",
        "docs:open": "node -e \"import('node:child_process').then(m=>m.exec(process.platform==='win32'?'start docs/index.html':(process.platform==='darwin'?'open docs/index.html':'xdg-open docs/index.html')))\"",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:integration": "node --test",
        "test:staged": "node scripts/lint-staged.mjs",
        "ver:preview": "npx autover --no-amend --dry-run --short",
        "ver:apply": "npx autover --guard-unchanged --short",
        "test": "node --test && npm run docs:check",
        "prepublishOnly": "npm run format:check && npm run lint && npm test && npm run docs",
        "postversion": "git push && git push --tags"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "index.d.ts",
        "src",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "fastify-plugin": "^6.0.0"
    },
    "peerDependencies": {
        "fastify": "5.x",
        "squirrelly": "^9.1.0"
    }
}
